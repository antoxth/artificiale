# === Variabili d'ambiente del sistema di prenotazione ===
# Copia questi nomi nel pannello Vercel (Settings → Environment Variables).
# NON mettere qui i valori reali e NON committare il file .env.

# --- Database (Supabase Postgres) ---
# Stringa di connessione del POOLER "Transaction" di Supabase (porta 6543).
# La trovi in Supabase → progetto → Connect → "Transaction pooler".
# Sostituisci [YOUR-PASSWORD] con la password del database.
# DATABASE_URL=postgresql://postgres.zuymlldglrafcbytjzyl:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Email (Resend) ---
# Chiave API di Resend. Senza questa, le email non partono ma la prenotazione
# funziona lo stesso (conferma mostrata a schermo).
RESEND_API_KEY=

# Mittente delle email. Provvisorio (senza dominio): usa l'onboarding di Resend.
# Con dominio verificato: "Artificiale sarà lei <anteprima@tuodominio.it>"
MAIL_FROM=Anteprima Docenti <onboarding@resend.dev>

# URL pubblico del sito (per il link di disdetta nelle email). Es. https://...vercel.app
SITE_URL=

# --- Sicurezza ---
# Password per accedere alla pagina /admin.
ADMIN_PASSWORD=

# Segreto per proteggere l'endpoint del cron dei promemoria.
# Impostalo uguale sia qui sia (Vercel lo invia in automatico ai propri cron).
CRON_SECRET=
